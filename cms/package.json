{
  "name": "trunche-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply trunche-cms --local --env local",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run --config vitest.config.ts",
    "check:deploy": "node scripts/check-deploy.mjs",
    "deploy": "pnpm build && pnpm check:deploy && wrangler deploy",
    "test:integration": "CMS_INTEGRATION=1 vitest run --config vitest.config.ts",
    "build:staging": "pnpm build && node scripts/prepare-staging.mjs",
    "deploy:staging": "pnpm build:staging && node scripts/check-staging.mjs && wrangler deploy --config wrangler.staging.jsonc"
  },
  "dependencies": {
    "image-size": "^2.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "20.0.11",
    "jsonc-parser": "3.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.50.0"
  }
}
